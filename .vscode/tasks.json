{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Asteroids",
            "type": "shell",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-std=c++23",
                "-g",
                "-IC:/vcpkg/installed/x64-mingw-dynamic/include",
                "*.cpp",
                "-o",
                "Asteroids.exe",
                "-LC:/vcpkg/installed/x64-mingw-dynamic/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}