{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Chess (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\Chess.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}\\build",
      "environment": [
        {
          "name": "PATH",
          "value": "${workspaceFolder}\\build\\deps;%PATH%"
        }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "Build Chess (MSVC)"
    }
  ]
}